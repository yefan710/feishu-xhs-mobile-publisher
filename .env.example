# Run npm run setup to generate a real random secret in .env.
SESSION_SECRET=
APP_PUBLIC_URL=https://publish.example.com
APP_DOMAIN=publish.example.com
HOST=127.0.0.1
PORT=3000
FEISHU_CONFIG_FILE=./data/feishu.json
PUBLISH_ACCOUNTS_FILE=./data/publish-accounts.json
MEDIA_CACHE_DIR=./data/media
# Only use behind a local reverse proxy. Do not set trust proxy to true globally.
TRUST_PROXY=loopback
